{
  "name": "GptSite",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the GPT site"
    },
    "description": {
      "type": "string",
      "description": "Short description or rates info"
    },
    "logo_url": {
      "type": "string",
      "description": "URL to the site's logo image"
    },
    "visit_url": {
      "type": "string",
      "description": "Referral link to visit the site"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a featured/top site"
    },
    "rank": {
      "type": "number",
      "description": "Rank order for featured sites (1-4)"
    },
    "badge": {
      "type": "string",
      "enum": [
        "new",
        "popular",
        "mobile_app",
        "none"
      ],
      "default": "none",
      "description": "Badge tag for the site"
    },
    "bonus_tag": {
      "type": "string",
      "description": "Optional bonus tag like 'Gamdom +25%'"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "description": "Star rating 1-5"
    },
    "category": {
      "type": "string",
      "enum": [
        "featured",
        "other"
      ],
      "default": "other"
    }
  },
  "required": [
    "name",
    "visit_url"
  ]
}